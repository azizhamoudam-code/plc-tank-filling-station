            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="FB_TankSimulation" pouType="functionBlock">
                <interface>
                  <inputVars>
                    <variable name="xInletValve">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="xDrainValve">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="tSimCycleTime">
                      <type>
                        <TIME />
                      </type>
                      <initialValue>
                        <simpleValue value="TIME#100ms" />
                      </initialValue>
                    </variable>
                    <variable name="fFillStepPercent">
                      <type>
                        <REAL />
                      </type>
                      <initialValue>
                        <simpleValue value="1.0" />
                      </initialValue>
                    </variable>
                    <variable name="fDrainStepPercent">
                      <type>
                        <REAL />
                      </type>
                      <initialValue>
                        <simpleValue value="1.5" />
                      </initialValue>
                    </variable>
                  </inputVars>
                  <outputVars>
                    <variable name="fLevelPercent">
                      <type>
                        <REAL />
                      </type>
                      <initialValue>
                        <simpleValue value="0.0" />
                      </initialValue>
                    </variable>
                  </outputVars>
                  <localVars>
                    <variable name="fbSimTick">
                      <type>
                        <derived name="TON" />
                      </type>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">fbSimTick(IN := NOT fbSimTick.Q, PT := tSimCycleTime);

IF fbSimTick.Q THEN
    IF xInletValve AND NOT xDrainValve THEN
        fLevelPercent := fLevelPercent + fFillStepPercent;
    ELSIF xDrainValve AND NOT xInletValve THEN
        fLevelPercent := fLevelPercent - fDrainStepPercent;
    END_IF;
END_IF;

IF fLevelPercent &gt; 100.0 THEN
    fLevelPercent := 100.0;
ELSIF fLevelPercent &lt; 0.0 THEN
    fLevelPercent := 0.0;
END_IF;</xhtml>
                  </ST>
                </body>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                    <ObjectId>3527df30-fbfb-4eb1-b3d0-28acd8e3b0b3</ObjectId>
                  </data>
                </addData>
              </pou>
            </data>
            <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
              <pou name="FB_TankController" pouType="functionBlock">
                <interface>
                  <inputVars>
                    <variable name="xStart">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="xReset">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="xEmergencyStop">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="fLevelPercent">
                      <type>
                        <REAL />
                      </type>
                    </variable>
                    <variable name="fFillSetpoint">
                      <type>
                        <REAL />
                      </type>
                      <initialValue>
                        <simpleValue value="80.0" />
                      </initialValue>
                    </variable>
                    <variable name="fDrainSetpoint">
                      <type>
                        <REAL />
                      </type>
                      <initialValue>
                        <simpleValue value="10.0" />
                      </initialValue>
                    </variable>
                    <variable name="tMixTime">
                      <type>
                        <TIME />
                      </type>
                      <initialValue>
                        <simpleValue value="TIME#10s0ms" />
                      </initialValue>
                    </variable>
                    <variable name="tFillTimeout">
                      <type>
                        <TIME />
                      </type>
                      <initialValue>
                        <simpleValue value="TIME#30s0ms" />
                      </initialValue>
                    </variable>
                    <variable name="tDrainTimeout">
                      <type>
                        <TIME />
                      </type>
                      <initialValue>
                        <simpleValue value="TIME#30s0ms" />
                      </initialValue>
                    </variable>
                  </inputVars>
                  <outputVars>
                    <variable name="xInletValve">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="xDrainValve">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="xMixer">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="eState">
                      <type>
                        <derived name="E_TankState" />
                      </type>
                      <initialValue>
                        <simpleValue value="E_TankState.IDLE" />
                      </initialValue>
                    </variable>
                    <variable name="nErrorCode">
                      <type>
                        <INT />
                      </type>
                    </variable>
                    <variable name="xFault">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                  </outputVars>
                  <localVars constant="true">
                    <variable name="ERR_NONE">
                      <type>
                        <INT />
                      </type>
                      <initialValue>
                        <simpleValue value="0" />
                      </initialValue>
                    </variable>
                    <variable name="ERR_FILL_TIMEOUT">
                      <type>
                        <INT />
                      </type>
                      <initialValue>
                        <simpleValue value="1" />
                      </initialValue>
                    </variable>
                    <variable name="ERR_DRAIN_TIMEOUT">
                      <type>
                        <INT />
                      </type>
                      <initialValue>
                        <simpleValue value="2" />
                      </initialValue>
                    </variable>
                    <variable name="ERR_EMERGENCY_STOP">
                      <type>
                        <INT />
                      </type>
                      <initialValue>
                        <simpleValue value="3" />
                      </initialValue>
                    </variable>
                    <variable name="ERR_UNKNOWN_STATE">
                      <type>
                        <INT />
                      </type>
                      <initialValue>
                        <simpleValue value="4" />
                      </initialValue>
                    </variable>
                  </localVars>
                  <localVars>
                    <variable name="fbTrigStart">
                      <type>
                        <derived name="R_TRIG" />
                      </type>
                    </variable>
                    <variable name="fbTrigReset">
                      <type>
                        <derived name="R_TRIG" />
                      </type>
                    </variable>
                    <variable name="fbFillTimeout">
                      <type>
                        <derived name="TON" />
                      </type>
                    </variable>
                    <variable name="fbDrainTimeout">
                      <type>
                        <derived name="TON" />
                      </type>
                    </variable>
                    <variable name="fbMixTimer">
                      <type>
                        <derived name="TON" />
                      </type>
                    </variable>
                    <variable name="xInletValveCmd">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="xDrainValveCmd">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="xMixerCmd">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">// Rising edge of the two push-buttons
fbTrigStart(CLK := xStart);
fbTrigReset(CLK := xReset);

// 1) EMERGENCY STOP - highest priority, always wins
IF xEmergencyStop THEN
    eState         := E_TankState.FAULT;
    nErrorCode     := ERR_EMERGENCY_STOP;
    xInletValveCmd := FALSE;
    xDrainValveCmd := FALSE;
    xMixerCmd      := FALSE;
ELSE
    // 2) NORMAL STATE MACHINE (see docs/state_diagram.md)
    CASE eState OF
        E_TankState.IDLE:
            xInletValveCmd := FALSE;
            xDrainValveCmd := FALSE;
            xMixerCmd      := FALSE;
            nErrorCode     := ERR_NONE;

            IF fbTrigStart.Q THEN
                eState := E_TankState.FILLING;
            END_IF;

        E_TankState.FILLING:
            xInletValveCmd := TRUE;
            xDrainValveCmd := FALSE;
            xMixerCmd      := FALSE;

            IF fLevelPercent &gt;= fFillSetpoint THEN
                xInletValveCmd := FALSE;
                eState         := E_TankState.MIXING;
            ELSIF fbFillTimeout.Q THEN
                nErrorCode := ERR_FILL_TIMEOUT;
                eState     := E_TankState.FAULT;
            END_IF;

        E_TankState.MIXING:
            xInletValveCmd := FALSE;
            xDrainValveCmd := FALSE;
            xMixerCmd      := TRUE;

            IF fbMixTimer.Q THEN
                xMixerCmd := FALSE;
                eState    := E_TankState.DRAINING;
            END_IF;

        E_TankState.DRAINING:
            xInletValveCmd := FALSE;
            xDrainValveCmd := TRUE;
            xMixerCmd      := FALSE;

            IF fLevelPercent &lt;= fDrainSetpoint THEN
                xDrainValveCmd := FALSE;
                eState         := E_TankState.COMPLETE;
            ELSIF fbDrainTimeout.Q THEN
                nErrorCode := ERR_DRAIN_TIMEOUT;
                eState     := E_TankState.FAULT;
            END_IF;

        E_TankState.COMPLETE:
            xInletValveCmd := FALSE;
            xDrainValveCmd := FALSE;
            xMixerCmd      := FALSE;

            IF fbTrigReset.Q THEN
                eState := E_TankState.IDLE;
            END_IF;

        E_TankState.FAULT:
            xInletValveCmd := FALSE;
            xDrainValveCmd := FALSE;
            xMixerCmd      := FALSE;

            IF fbTrigReset.Q AND NOT xEmergencyStop THEN
                nErrorCode := ERR_NONE;
                eState     := E_TankState.IDLE;
            END_IF;
    ELSE
        eState     := E_TankState.FAULT;
        nErrorCode := ERR_UNKNOWN_STATE;
    END_CASE;
END_IF;

// Each timer runs only in its own state, so it resets on leaving it.
fbFillTimeout (IN := (eState = E_TankState.FILLING),  PT := tFillTimeout);
fbDrainTimeout(IN := (eState = E_TankState.DRAINING), PT := tDrainTimeout);
fbMixTimer    (IN := (eState = E_TankState.MIXING),   PT := tMixTime);

// 3) HARD SAFETY INTERLOCKS - applied last, directly on the outputs
xInletValve := xInletValveCmd AND NOT xDrainValveCmd;
xDrainValve := xDrainValveCmd AND NOT xInletValveCmd;
xMixer      := xMixerCmd AND (fLevelPercent &gt;= fFillSetpoint);
xFault      := (eState = E_TankState.FAULT);</xhtml>
                  </ST>
                </body>
